ne!important;inset:auto!important;height:auto!important;max-height:none!important;min-height:0!important;min-width:0;animation:none!important;text-shadow:none!important}\n.mirae-lt :where(h1,h2,h3,p){display:block!important;width:auto!important;padding:0!important;overflow:visible!important}\n.mirae-lt :where(h1,h2,h3)::before,.mirae-lt :where(h1,h2,h3)::after{content:none!important}\n.mirae-lt h1{font-size:clamp(30px,4vw,46px)!important;line-height:1.4!important;font-weight:800!important;margin:20px 0!important;color:#142d45!important}\n.mirae-lt h2{font-size:clamp(25px,3vw,32px)!important;line-height:1.5!important;font-weight:750!important;margin:10px 0 20px!important;color:#142d45!important}\n.mirae-lt h3{font-size:21px!important;line-height:1.5!important;font-weight:700!important;margin:0 0 10px!important;color:#142d45!important}\n.mirae-lt p,.mirae-lt li{line-height:1.8!important}\n.mirae-lt .mlt-hero{display:block!important;height:auto!important;overflow:visible!important}\n.mirae-lt .mlt-hero-bottom{display:block!important}\n.mirae-lt .mlt-gallery{display:grid!important;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:18px;margin-top:28px;align-items:start}\n.mirae-lt .mlt-gallery>br{display:none!important}\n.mirae-lt .mlt-gallery .mlt-separator{margin:0!important;padding:0!important;width:100%!important;clear:none!important}\n.mirae-lt .mlt-gallery a{display:block!important;margin:0!important;padding:0!important;width:100%!important}\n.mirae-lt .mlt-gallery img{display:block!important;width:100%!important;max-width:100%!important;height:auto!important;margin:0!important;object-fit:contain}\n.mirae-lt .mlt-grid,.mirae-lt .mlt-steps{grid-template-columns:minmax(0,1fr) minmax(0,1fr)}\n.mirae-lt .mlt-contact h2{color:#fff!important}\n@media(max-width:620px){.mirae-lt .mlt-gallery,.mirae-lt .mlt-grid,.mirae-lt .mlt-steps{grid-template-columns:minmax(0,1fr)!important}}\n.mirae-lt .mlt-math-image{max-width:660px;margin:28px auto 0!important;padding:10px;background:#fff;border:1px solid #dce6e9;border-radius:18px}.mirae-lt .mlt-math-image a{display:block!important;margin:0!important}.mirae-lt .mlt-math-image img{display:block!important;width:100%!important;max-width:100%!important;height:auto!important;margin:0!important;border-radius:10px}.mirae-lt .mlt-math-image figcaption{font-size:13px;line-height:1.6;padding-top:8px;text-align:center;color:#546776}</style><article class=\"mirae-lt\" aria-label=\"미래엔 수학 계산력 진단평가 안내\">\n<div class=\"mlt-hero\"><p class=\"mlt-eyebrow\">코코스학원 · 미래엔 수학</p><h1>우리 아이 연산,<br>어디부터 채워야 할까요?</h1><p class=\"mlt-lead\">계산력 진단평가로 현재 연산 실력을 살펴보고,<br>아이에게 맞는 학습의 시작점을 찾습니다.</p><div class=\"mlt-hero-bottom\"><p>계산이 자주 틀리거나 문제를 푸는 데 시간이 오래 걸린다면, 어떤 부분에서 어려움을 겪는지 먼저 확인하는 것이 필요합니다. 미래엔 수학 계산력 진단평가는 초등 연산 영역을 진단하고, 보완할 부분을 찾아 학습 방향을 정하는 데 활용합니다.</p><div class=\"mlt-tags\"><span class=\"mlt-tag\">초등 연산 진단</span><span class=\"mlt-tag\">단계별 100문항</span><span class=\"mlt-tag\">계산력플러스 교재 연계</span></div></div></div>\n<figure class=\"mlt-math-image\"><a href=\"https://blogger.googleusercontent.com/img/b/R29vZ2xl/AVvXsEgDyekJnSURswkN3aS3znUDCiYiDMPIvs1rdl0MUQiiLsz60o6LJ7ENMsxSgT4_gX-fkIgw3_yOhpcsUHBB5LO3fPoDKr4P3uGRNUI7rCIs6XHNapRy5i8T5Qhj0piLCosyGgHo8c8U8IJsVGPqtqmklPILKSA70_iSkcs0ecM1FcSezdqxSXVMerL3pdcz/s1188/%E1%84%89%E1%85%B3%E1%84%8F%E1%85%B3%E1%84%85%E1%85%B5%E1%86%AB%E1%84%89%E1%85%A3%E1%86%BA%202026-10-09%20%E1%84%8B%E1%85%A9%E1%84%8C%E1%85%A5%E1%86%AB%2011.27.04.png\" target=\"_blank\" rel=\"noopener\"><img src=\"https://blogger.googleusercontent.com/img/b/R29vZ2xl/AVvXsEgDyekJnSURswkN3aS3znUDCiYiDMPIvs1rdl0MUQiiLsz60o6LJ7ENMsxSgT4_gX-fkIgw3_yOhpcsUHBB5LO3fPoDKr4P3uGRNUI7rCIs6XHNapRy5i8T5Qhj0piLCosyGgHo8c8U8IJsVGPqtqmklPILKSA70_iSkcs0ecM1FcSezdqxSXVMerL3pdcz/s1188/%E1%84%89%E1%85%B3%E1%84%8F%E1%85%B3%E1%84%85%E1%85%B5%E1%86%AB%E1%84%89%E1%85%A3%E1%86%BA%202026-10-09%20%E1%84%8B%E1%85%A9%E1%84%8C%E1%85%A5%E1%86%AB%2011.27.04.png\" width=\"1110\" height=\"1188\" alt=\"미래엔 수학 계산력 진단평가 안내 자료\" decoding=\"async\"></a></figure>\n<div class=\"mlt-section\"><p class=\"mlt-eyebrow\">01 · 무엇을 확인하나요?</p><h2>정답률과 풀이 진행을 함께 살펴봅니다</h2><p class=\"mlt-sub\">정해진 시간 안에 푼 문항과 정답률을 참고해, 현재 연산 학습 상태와 보완할 부분을 확인합니다.</p><div class=\"mlt-grid\"><div class=\"mlt-card\"><span class=\"mlt-label\">연산 정확도</span><h3>어떤 계산에서 어려움을 겪나요?</h3><p>틀린 문항과 연결된 학습 내용을 확인하고, 다시 익힐 필요가 있는 연산 영역을 살펴봅니다.</p></div><div class=\"mlt-card mlt-blue\"><span class=\"mlt-label\">풀이 진행 정도</span><h3>시간 안에 얼마나 해결했나요?</h3><p>주어진 시간 안에 해결한 문항과 남은 문항을 확인합니다. 푼 양뿐 아니라 정답률을 함께 참고합니다.</p></div></div><div class=\"mlt-band\">이 평가는 초등 연산 영역을 살펴보는 평가입니다. 수학 전 영역의 실력을 종합적으로 평가하는 검사와는 범위가 다릅니다.</div></div>\n<div class=\"mlt-section\"><p class=\"mlt-eyebrow\">02 · 어떻게 구성되어 있나요?</p><h2>아이에게 맞는 단계로 응시합니다</h2><div class=\"mlt-grid\"><div class=\"mlt-card\"><span class=\"mlt-label\">문항 수</span><div class=\"mlt-big\">100<small>문항</small></div><h3>모든 단계의 문항 수는 동일</h3><p>첨부 안내 자료 기준으로 각 단계는 100문항으로 구성됩니다.</p></div><div class=\"mlt-card\"><span class=\"mlt-label\">시험 시간</span><div class=\"mlt-big\">단계별 <small>상이</small></div><h3>응시 단계에 맞춰 안내</h3><p>단계마다 시험 시간이 다릅니다. 정확한 응시 시간은 상담 시 안내받아 주세요.</p></div></div><p class=\"mlt-note\">자료상 F단계에는 예비중학 단계가 포함되어 있습니다. 자녀에게 적절한 응시 단계는 학습 이력을 확인한 뒤 안내합니다.</p></div>\n<div class=\"mlt-section\"><p class=\"mlt-eyebrow\">03 · 언제 활용하나요?</p><h2>시작 전에도, 한 단계를 마친 후에도</h2><div class=\"mlt-grid\"><div class=\"mlt-card\"><span class=\"mlt-label\">처음 학습을 시작할 때</span><h3>연산 학습의 출발점 찾기</h3><p>신규 학생의 연산 능력을 살펴보고, 결과를 참고해 계산력플러스 교재의 학습 시작점을 정할 수 있습니다.</p></div><div class=\"mlt-card mlt-blue\"><span class=\"mlt-label\">학습 중 점검이 필요할 때</span><h3>다음 단계로 가기 전 확인</h3><p>특정 단계의 학습을 마친 뒤 성취도를 확인하고, 상위 단계로 나아갈지 한 단계를 더 복습할지 판단하는 데 활용합니다.</p></div></div></div>\n<div class=\"mlt-section\"><p class=\"mlt-eyebrow\">04 · 결과는 어떻게 활용하나요?</p><h2>필요한 학습을 교재와 연결합니다</h2><p>문항별로 연결된 계산력플러스 교재 정보를 참고해 보완할 학습 내용을 찾습니다. 시간 안에 모두 풀었는지, 해결한 문항의 정답률은 어떤지에 따라 다음 학습 방향을 살펴봅니다.</p><ol class=\"mlt-steps\" style=\"margin-top:24px\"><li><span class=\"mlt-num\">결과 살펴보기</span><h3>푼 문항과 정답률 확인</h3><p>풀이 진행 정도와 틀린 문항을 함께 살펴봅니다. 필요에 따라 추가 시간을 주어 남은 문항을 풀고 확인할 수도 있습니다.</p></li><li><span class=\"mlt-num\">학습 방향 정하기</span><h3>진도 진행 또는 보완 학습</h3><p>평가 결과와 연계 교재 정보를 참고해 다음 단계 학습이나 부족한 부분의 반복 학습을 계획합니다.</p></li></ol><p class=\"mlt-note\">자료에 정답률의 구체적인 판정 수치는 제시되어 있지 않습니다. 결과에 따른 교재와 학습 진도는 상담을 통해 안내합니다.</p></div>\n<div class=\"mlt-section\"><p class=\"mlt-eyebrow\">학부모님이 궁금해하시는 점</p><h2>응시 전에 확인해 주세요</h2><details open><summary>시험 전에 어떤 정보를 알려드리면 되나요?</summary><p>자녀의 학년, 현재 공부하는 수학 교재, 최근 어려워하는 연산 내용을 알려주시면 상담에 도움이 됩니다.</p></details><details open><summary>100문항을 다 풀지 못하면 어떻게 하나요?</summary><p>자료에서는 해결한 문항의 정답률과 미해결 문항에 연결된 교재를 참고하도록 안내합니다. 모두 풀었는지 여부만으로 판단하지 않고, 필요한 보완 학습을 살펴봅니다.</p></details><details open><summary>영어 레벨테스트처럼 30분 또는 60분인가요?</summary><p>수학 계산력 진단평가는 단계마다 시간이 다릅니다. 영어 레벨테스트의 검사 시간을 적용하지 않으며, 응시할 단계의 시간을 별도로 확인해 주세요.</p></details></div>\n<div class=\"mlt-contact\"><h2>우리 아이의 연산 학습,<br>현재 수준에서 시작하세요</h2><p>자녀의 학년과 수학 학습 경험을 알려주세요.<br>계산력 진단평가 진행 방법을 안내해 드리겠습니다.</p><a href=\"https://talk.naver.com/profile/c/cocos\" target=\"_blank\" rel=\"noopener\" style=\"display:inline-block;background:#dbeaa8;color:#193e33;padding:13px 22px;border-radius:12px;font-weight:800;text-decoration:none;margin-top:22px\">네이버 톡톡으로 문의하기</a><br><span class=\"mlt-phone\">코코스학원 706-0505</span></div>\n<div class=\"mlt-footer\">자료 기준: 첨부된 ‘초등 계산력 진단평가’ 교육자료(등록일 2020.03.24) · 학부모용 재구성<br>실제 응시 단계와 운영 방식은 학원 상담 시 확인해 주세요.</div></article>", "author": {"id": "04783440165843078075", "displayName": "리카수니", "url": "https://www.blogger.com/profile/04783440165843078075", "image": {"url": "//blogger.googleusercontent.com/img/b/R29vZ2xl/AVvXsEij7m3uPaqJtF6qA_dfqRr4d9tEsZo_dlxVjEX1jRjybBZql7Kw8ry27dA0fV7SMK2ZO0doLsUCW3qnywwK9fBo6V4RG-xog5avEICcLozp6-6Y5S4EhVssm7E80YhbgdwrIS3tWvNg80AYkO_VySJW4znl3OOr7iDwg3X_7AeTpMViKg/s35/%E1%84%89%E1%85%B3%E1%84%8F%E1%85%B3%E1%84%85%E1%85%B5%E1%86%AB%E1%84%89%E1%85%A3%E1%86%BA%202026-08-01%20%E1%84%8B%E1%85%A9%E1%84%92%E1%85%AE%202.26.48.png"}}, "replies": {"totalItems": "0", "selfLink": "https://www.googleapis.com/blogger/v3/blogs/489843540806914986/posts/3328938026287258622/comments"}, "labels": ["레테 미래엔수학", "미래엔수학"], "etag": "\"dGltZXN0YW1wOiAxNzkxNTEzMzExNDg5Cm9mZnNldDogLTI1MjAwMDAwCg\""}