:14px;overflow:hidden;background:#fff;text-decoration:none !important;color:#1b2438 !important}\n.ct-tgrid a img{display:block;width:100%;height:auto;aspect-ratio:3/2;object-fit:cover;background:#0e1f46}\n.ct-tgrid a span{display:block;padding:10px 12px 0;font-size:11.5px;font-weight:800;letter-spacing:.08em;color:#b08a3a}\n.ct-tgrid a b{display:block;padding:2px 12px 12px;font-size:15px;font-weight:900;color:#0e1f46;line-height:1.4}\n.ct-tgrid a i{display:block;margin:10px 12px 12px;padding:8px 0;border-radius:9px;background:#0e1f46;color:#e8c682;font-style:normal;font-size:13px;font-weight:800;text-align:center;margin-top:auto}\n@media(max-width:620px){.ct-tgrid{grid-template-columns:repeat(2,minmax(0,1fr))}.ct-navt{font-size:21px}}\n</style>\n<div class=\"ct-wrap\"><div class=\"ct-tnav\"><b>TEACHERS</b><a class=\"on\" href=\"https://www.cocosedu.co.kr/2026/08/6-3.html\">리카수니(영어)</a><a href=\"https://www.cocosedu.co.kr/2025/11/blog-post_54.html\">리치(영어)</a><a href=\"https://www.cocosedu.co.kr/2025/11/blog-post_5.html\">마야(영어) </a><a href=\"https://www.cocosedu.co.kr/2026/09/1123.html\">수학</a><a href=\"https://www.cocosedu.co.kr/2026/09/9.html\">과학</a><a href=\"https://www.cocosedu.co.kr/2026/03/blog-post_20.html\">국어</a></div>\n<div class=\"ct-top\" style=\"box-sizing:border-box;width:100%;max-width:100%;overflow:hidden;\"><div style=\"box-sizing:border-box;width:100%;max-width:100%;overflow:hidden;\"><div class=\"ct-photo\" style=\"box-sizing:border-box;width:100%;max-width:100%;overflow:hidden;\"><img src=\"https://blogger.googleusercontent.com/img/b/R29vZ2xl/AVvXsEh2k5mtgfsGBTJBESaXSQk7p38PFAIwJ404yPuoLxWsqIe1LNXyTKOXPkHhcNe9vYTjR2WpL6SeH8yXaS7EY9SHUjAKmmNe5BnRVf7b3poyae_7EejWh8zbENXVqtTvJasXaZ1dzy7AMV8FkGad-gTZDBr9nMQ-oi9tp3zr_1w4N-XAXW_NTgxGvzp5atQ9/s1200/th2_rich.jpg\" width=\"1200\" height=\"800\" alt=\"이매동 코코스학원 리치 선생님\" style=\"width:100%;max-width:100%;height:auto;aspect-ratio:4/5;object-fit:cover;object-position:100% 0;display:block\"></div><div class=\"ct-cap\" style=\"box-sizing:border-box;width:100%;max-width:100%;overflow:hidden;\"><span>리치 선생님</span><span style=\"color:#b08a3a\">고등부 밀착 관리</span></div></div><div class=\"ct-txt\" style=\"box-sizing:border-box;width:100%;max-width:100%;overflow:hidden;\"><span class=\"ct-kicker\">리치 선생님 · 예비고 &amp; 고등부 밀착 관리</span><h1>단어 반복부터<br>기출 분석까지<br>완벽 케어.</h1><p class=\"ct-lead\">영어 학습의 체력은 <strong>정교한 관리</strong>에서 나옵니다.</p><p class=\"intro\">단순히 수업만 듣는 영어가 아닙니다. 보카라이팅 반복 훈련과 데일리 오답 관리를 통해 <strong>아는 것을 확실히 내 것으로</strong> 만드는 진짜 실전 영어를 가르칩니다.</p></div></div>\n<div class=\"ct-grid3\" style=\"box-sizing:border-box;width:100%;max-width:100%;overflow:hidden;\"><div class=\"ct-cell\" style=\"box-sizing:border-box;width:100%;max-width:100%;overflow:hidden;\"><b>데일리 오답</b><span>매일 틀린 것을 그날 안에 정리합니다</span></div><div class=\"ct-cell\" style=\"box-sizing:border-box;width:100%;max-width:100%;overflow:hidden;\"><b>보카라이팅</b><span>쓰면서 외우고, 체화될 때까지 누적 재시험</span></div><div class=\"ct-cell\" style=\"box-sizing:border-box;width:100%;max-width:100%;overflow:hidden;\"><b>기출 정밀 분석</b><span>고2·고3 기출로 출제자의 의도를 읽습니다</span></div></div>\n<div class=\"ct-eyebrow\">FEATURES</div><h2 class=\"ct-h2\">클래스 핵심 특징</h2>\n<div class=\"ct-feat\" style=\"box-sizing:border-box;width:100%;max-width:100%;overflow:hidden;\"><em>FEATURE 01</em><h3>예비고 · 주 2회 수업</h3><p class=\"sub\">고등 진입 전에 끝내는 기본 체력</p><p><strong>단어</strong> — 보카라이팅 기반 데일리 오답 및 재시험</p><p><strong>독해</strong> — 데일리 미니 모의고사로 취약 유형 정복</p><p><strong>문법</strong> — 고등 핵심 개념 연계 및 기출 서술형 훈련</p></div>\n<div class=\"ct-feat\" style=\"box-sizing:border-box;width:100%;max-width:100%;overflow:hidden;\"><em>FEATURE 02</em><h3>고등부 · 판서 수업 + 자기주도 집중</h3><p class=\"sub\">모의고사와 내신을 동시에 잡는 설계</p><p><strong>독해</strong> — 고2·고3 기출 정밀 분석 및 오답 근거 피드백</p><p><strong>내신</strong> — 학교별 맞춤 자료 및 변형 문제 압축 몰입</p><p><strong>구성</strong> — 판서 수업과 자기주도 집중 학습 병행</p></div>\n<!-- 애드센스: 아래 전용 컨테이너 안에 광고 코드 삽입 -->\n<div style=\"box-sizing:border-box;display:block;margin:28px auto;max-width:860px;overflow:hidden;text-align:center;width:100%\"></div>\n<div class=\"ct-eyebrow\">ROADMAP</div><h2 class=\"ct-h2\">학년별 학습 목표</h2>\n<div style=\"box-sizing:border-box;width:100%;max-width:100%;overflow:hidden;\"><div class=\"ct-step\"><b>01</b><span>지문 분석 및 어휘 누적 반복 — 지문 구조를 명확히 파악하고, 잊기 쉬운 단어를 체화할 때까지 누적 반복 테스트</span></div><div class=\"ct-step\"><b>02</b><span>단계별 워크북 &amp; 기출 정밀 풀이 — 수준에 맞춘 워크북으로 기본기를 다진 후 최신 기출을 정밀 풀이</span></div><div class=\"ct-step\"><b>03</b><span>적중 예상 문제 &amp; 서술형 클리닉 — 실전 감각을 올리는 예상 문제와 일대일 서술형 교정</span></div></div>\n<div class=\"ct-rec\" style=\"box-sizing:border-box;width:100%;max-width:100%;overflow:hidden;\"><strong class=\"t\">이런 학생에게 추천합니다</strong><p>단어를 외워도 <strong>금방 잊어버리는</strong> 학생</p><p>고등 진입 전 <strong>기본 체력</strong>을 탄탄히 만들고 싶은 예비고 학생</p><p><strong>모의고사와 내신</strong>을 동시에 상위권으로 끌어올리고 싶은 고등학생</p></div>\n<div class=\"ct-eyebrow\">TEACHERS</div><div class=\"ct-navt\">다른 선생님도 만나보세요</div><div class=\"ct-tgrid\"><a href=\"https://www.cocosedu.co.kr/2026/08/6-3.html\"><img src=\"https://blogger.googleusercontent.com/img/b/R29vZ2xl/AVvXsEiR86QUaUE0aPH_-8i39-AIdLFafzNXyhgrEA_drNDQ7dvWieo4dEkl7RL_VR1sUV7Bcexob8pRMaQ3oZIKf_PqLDvntI6F59cDuu83ghphwNPykVqzYER2VPVoEXrxW-VOP8PnmsfaejKo-7b1_KJTMpSQNpX-DFXMfO8p2HrnpBq0d5Cz1gcfhnrcCHlb/s480/th1_rika.jpg\" width=\"480\" height=\"320\" alt=\"코코스학원 리카수니 원장\" loading=\"lazy\"><span>영어</span><b>리카수니 원장</b><i>소개 보기 →</i></a><a href=\"https://www.cocosedu.co.kr/2025/11/blog-post_5.html\"><img src=\"https://blogger.googleusercontent.com/img/b/R29vZ2xl/AVvXsEguisiq4rUyA0qd7SHRYigEaGxe423fYDw_a1mgu1fJ0r_Tj7F2DlaY9CJqoDcgPwBdg_WsGv4j6N2IPbiaGTPr_OooKjhebo_9wlyHZJaC5l35GY2o7EAGLvMkZzwZPkODNWVFwc6zatzlOvlTpacZ1vUmOYWOa7vhdmiR3CZVmFHsUeqP5sU1akgn653J/s480/th3_maya.jpg\" width=\"480\" height=\"320\" alt=\"코코스학원 마야 선생님\" loading=\"lazy\"><span>영어</span><b>마야 선생님</b><i>소개 보기 →</i></a><a href=\"https://www.cocosedu.co.kr/2026/09/1123.html\"><img src=\"https://blogger.googleusercontent.com/img/b/R29vZ2xl/A